<UserControl x:Class="RPG.Menu"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid Background="#AA000000">
        <Border HorizontalAlignment="Center" VerticalAlignment="Center" Width="320" Background="#CC1E1E1E" Padding="24">
            <StackPanel>
                <TextBlock Text="Menu principal" FontSize="26" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" Margin="0 0 0 12" />
                <Button x:Name="PlayButton" Content="Jouer" Height="40" Click="OnPlayClicked" Margin="0 0 0 8" />
                <Button x:Name="OptionsButton" Content="Options" Height="40" Click="OnOptionsClicked" Margin="0 0 0 8" />
                <Button x:Name="QuitButton" Content="Quitter" Height="40" Click="OnQuitClicked" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
